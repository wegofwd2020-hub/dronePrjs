{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://closedspace.local/schemas/map.schema.json",
  "title": "Warehouse Map",
  "description": "Structural map of a warehouse floor. Consumed by closedSpace mission planner.",
  "type": "object",
  "required": ["schema_version", "warehouse_id", "units", "coverage_polygon", "takeoff_pad", "aisles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "warehouse_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "units": {
      "type": "string",
      "enum": ["meters"]
    },
    "surveyed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO-8601 date (YYYY-MM-DD) the map was last surveyed."
    },
    "surveyed_by": {
      "type": "string",
      "minLength": 1
    },
    "coverage_polygon": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/point2d" }
    },
    "takeoff_pad": {
      "type": "object",
      "required": ["position", "yaw_deg", "radius_m"],
      "additionalProperties": false,
      "properties": {
        "position": { "$ref": "#/$defs/point3d" },
        "yaw_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "radius_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "no_go_zones": {
      "type": "array",
      "items": { "$ref": "#/$defs/noGoZone" },
      "default": []
    },
    "aisles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/aisle" }
    }
  },
  "$defs": {
    "point2d": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "point3d": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "noGoZone": {
      "type": "object",
      "required": ["id", "polygon", "z_min", "z_max"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point2d" }
        },
        "z_min": { "type": "number", "minimum": 0 },
        "z_max": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "aisle": {
      "type": "object",
      "required": ["id", "centerline", "width_m", "direction", "racks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "centerline": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": { "$ref": "#/$defs/point2d" },
            "end":   { "$ref": "#/$defs/point2d" }
          }
        },
        "width_m": { "type": "number", "exclusiveMinimum": 0 },
        "direction": {
          "type": "string",
          "enum": ["any", "north_to_south", "south_to_north", "east_to_west", "west_to_east"]
        },
        "racks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "west":  { "type": "array", "items": { "$ref": "#/$defs/rack" } },
            "east":  { "type": "array", "items": { "$ref": "#/$defs/rack" } },
            "north": { "type": "array", "items": { "$ref": "#/$defs/rack" } },
            "south": { "type": "array", "items": { "$ref": "#/$defs/rack" } }
          }
        }
      }
    },
    "rack": {
      "type": "object",
      "required": ["id", "position_along", "length_m", "face_offset_m", "yaw_deg", "levels"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "position_along": { "type": "number", "minimum": 0 },
        "length_m": { "type": "number", "exclusiveMinimum": 0 },
        "face_offset_m": { "type": "number", "exclusiveMinimum": 0 },
        "yaw_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/level" }
        }
      }
    },
    "level": {
      "type": "object",
      "required": ["index", "height_m"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "height_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
