{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://closedspace.local/schemas/mission_report.schema.json",
  "title": "Mission Report",
  "description": "Post-flight summary of one closedSpace warehouse-inventory mission. Generated by closedSpace.report.builder, consumed by the ground-station UI and the inventory pipeline.",
  "type": "object",
  "required": [
    "schema_version",
    "mission_id",
    "warehouse_id",
    "map_id",
    "started_utc",
    "finished_utc",
    "planned_waypoints",
    "captured_waypoints",
    "missed_waypoints",
    "coverage_pct",
    "telemetry_summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "mission_id": { "type": "string", "minLength": 1 },
    "warehouse_id": { "type": "string", "minLength": 1 },
    "map_id": {
      "type": "string",
      "description": "Identifier of the map this mission flew (typically the map's warehouse_id, but kept separate so multi-map deployments don't collide)."
    },
    "started_utc": { "type": "string", "format": "date-time" },
    "finished_utc": { "type": "string", "format": "date-time" },
    "planned_waypoints": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of capture waypoints the planner emitted. Transit / takeoff / landing waypoints are excluded — capture coverage is the operator-facing metric."
    },
    "captured_waypoints": { "type": "integer", "minimum": 0 },
    "missed_waypoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/missedWaypoint" }
    },
    "coverage_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "100 * captured / planned. Exact arithmetic — never rounded."
    },
    "telemetry_summary": { "$ref": "#/$defs/telemetrySummary" }
  },
  "$defs": {
    "missedWaypoint": {
      "type": "object",
      "required": ["aisle_id", "rack_id", "level_index", "reason", "detail"],
      "additionalProperties": false,
      "properties": {
        "aisle_id": { "type": "string" },
        "rack_id": { "type": "string" },
        "level_index": { "type": "integer", "minimum": 0 },
        "reason": {
          "type": "string",
          "enum": ["low_resolution", "low_focus", "storage_error"]
        },
        "detail": { "type": "string" }
      }
    },
    "telemetrySummary": {
      "type": "object",
      "required": ["state_transitions"],
      "additionalProperties": false,
      "properties": {
        "state_transitions": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of FlightController state changes observed during the mission."
        }
      }
    }
  }
}
